# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# Scratch output from ad-hoc CLI runs (the curated library lives in library/)
out/
specs/
# ...except the specs transcribed from real datasheets
!datasheets/*/specs/

# Resumable build state of the generated library (not part of the library)
library/.build/

# Interrupted atomic writes
*.tmp
*.part

# Local data / downloads (CEC CSVs are cached in ~/.cache, not in the repo)
*.csv.gz
/data/
!tests/data/

# Secrets / local config
.env
.env.*
!.env.example

